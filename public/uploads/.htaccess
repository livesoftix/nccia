# Sensitive uploads (CNIC, accused photos, enquiry files). No direct HTTP access
# and never executable — they are served only through the authenticated
# /api/secure-file route, which reads them from disk server-side.
Require all denied
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
php_flag engine off
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|pht|cgi|pl|py|sh|asp|aspx|jsp)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar

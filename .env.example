APP_NAME=NCCIA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nccia.real-erp.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=90
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=realerp_nccia
DB_USERNAME=realerp_nccia
DB_PASSWORD=

SESSION_DRIVER=database
# For 1–10 lakh records / higher concurrency, switch to redis (requires php-redis on server):
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
SESSION_LIFETIME=30
# Minutes of inactivity before IdleTimeout logs the user out.
SESSION_IDLE_TIMEOUT=5
SESSION_ABSOLUTE_TIMEOUT=480
# Required roles are restricted to MFA enrollment until they confirm an authenticator.
NCCIA_MFA_REQUIRED_ROLES=admin,superadmin,director_general,admin_forensic
NCCIA_MFA_REQUIRE_ALL=false
MFA_ISSUER=NCCIA
# Generate and retain an independent random audit key in production secret storage.
# If empty, APP_KEY is used; changing it then invalidates v2 ledger verification.
AUDIT_HMAC_KEY=
AUDIT_REQUIRE_WRITES=true
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.nccia.real-erp.net
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# OTP: iwhost blocks smtp.gmail.com (cert becomes decloud.iwhost.org).
# Use a cPanel mailbox OR sendmail — NOT Gmail SMTP.
MAIL_MAILER=sendmail
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=noreply@nccia.real-erp.net
MAIL_PASSWORD=your-cpanel-email-password
MAIL_FROM_ADDRESS=noreply@nccia.real-erp.net
MAIL_FROM_NAME="NCCIA Portal"


SANCTUM_STATEFUL_DOMAINS=nccia.real-erp.net,www.nccia.real-erp.net

# Google reCAPTCHA v2 ("I'm not a robot" checkbox). Set true after adding real keys.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=nccia.real-erp.net,www.nccia.real-erp.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ADP PDF extract service (Python FastAPI on same server or local machine)
ADP_API_URL=http://127.0.0.1:8001
ADP_API_TIMEOUT=120
ADP_APPROVED_DISCLOSURE=false
ADP_ALLOWED_HOSTS=127.0.0.1
ADP_ALLOWED_PORTS=443,8001
# Development-only HTTP loopback. Production requires approved TLS even for internal services.
ADP_ALLOW_LOCAL_HTTP=false
ADP_ALLOW_PRIVATE_NETWORK=false

# PDF import OCR — Python 3.10+ with PyMuPDF, Pillow, pytesseract, and Tesseract installed
PDF_EXTRACT_PYTHON=python3
PDF_OCR_MAX_PAGES=3
# Node tesseract.js fallback (jailshell / low disk — bash scripts/setup-ocr-lite.sh)
PDF_OCR_NODE=
PDF_OCR_NODE_MODULES=
# false = use queue workers (required for large batches)
PDF_IMPORT_SYNC=false

# ---------------------------------------------------------------------------
# SMS Gateway (Local Pakistani providers: Jazz / Telenor / Ufone / Zong)
# ---------------------------------------------------------------------------
# Master switch: false = log only, never hit the gateway (safe for testing).
SMS_ENABLED=false
SMS_PROVIDER=generic
# Gateway endpoint the provider gave you. Examples:
#   https://api.sms.com.pk/sms.aspx
#   https://sendpk.com/api/sms.php
#   https://www.sms4everyone.com/api/smsapi.aspx
SMS_API_URL=
# get or post
SMS_HTTP_METHOD=post
SMS_ALLOWED_HOSTS=
SMS_ALLOWED_PORTS=443
SMS_API_KEY=
SMS_USERNAME=
SMS_PASSWORD=
SMS_ROUTE_ID=
SMS_SENDER_ID=NCCIA
# Substring expected in a success response, e.g. "ok" or "1" or "success".
# Leave empty to skip response validation.
SMS_SUCCESS_MATCH=
SMS_TIMEOUT=15

# ── Python OCR pipeline (python/nccia_ocr) ───────────────────────────
# Interpreter with python/requirements.txt installed (use the venv path in production).
OCR_PYTHON=python3
OCR_ENGINE=tesseract
# "+"-separated Tesseract languages; add urd once urd.traineddata is installed.
OCR_LANGUAGES=eng
OCR_TESSERACT_CMD=
OCR_DPI=300
OCR_MAX_PAGES=1000
OCR_MAX_FILE_MB=512
# Scanned pages after this many are not OCR'd (fields are on the leading report pages). 0 = all pages.
OCR_MAX_OCR_PAGES=5
OCR_CHUNK_PAGES=10
OCR_CHUNK_TIMEOUT=900
OCR_QUEUE=ocr
OCR_AUTO_ACCEPT=true
OCR_MIN_FIELD_CONFIDENCE=0.85
OCR_MIN_PAGE_CONFIDENCE=0.70

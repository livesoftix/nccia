# Supply generated secrets through protected deployment storage, never commit real values.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://nccia.example.invalid
APP_KEY=
AUDIT_HMAC_KEY=
AUDIT_REQUIRE_WRITES=true
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1
SESSION_DRIVER=database
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict
SESSION_LIFETIME=60
SESSION_IDLE_TIMEOUT=15
SESSION_ABSOLUTE_TIMEOUT=240
NCCIA_MFA_REQUIRE_ALL=true
UPLOAD_SCAN_REQUIRED=true
UPLOAD_SCANNER_BINARY=/usr/bin/clamscan
UPLOAD_SCAN_TIMEOUT=10
DB_CONNECTION=mysql
DB_HOST=
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ATTR_SSL_CA=
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_ENCRYPTION=ssl
MAIL_PORT=465
MAIL_HOST=
MAIL_USERNAME=
MAIL_PASSWORD=
SMS_ENABLED=false
ADP_APPROVED_DISCLOSURE=false
ADP_ALLOW_LOCAL_HTTP=false
# NCCIA_BACKUP_KEY is a separate base64 32-byte secret for backup.php, provided only to backup jobs.
